# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/

# Secrets
.env

# Data. The processed files (data/processed/, 3.4 MB) are committed, so a deploy never
# has to run `python -m app.data.ingest` (docs/deployment-plan.md); anything else under
# data/ stays out. Anchored to the project root: a bare "data/" would also ignore the
# app/data/ source package.
/data/*
!/data/processed/

# Request logs (LOG_FILE)
/logs/

# Tool caches
.pytest_cache/
.ruff_cache/

# Evaluation run outputs (docs/eval.md §9)
tests/eval/results/
