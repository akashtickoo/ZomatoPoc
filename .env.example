# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# LLM settings. The model must support Groq's strict structured outputs and
# reasoning_effort: openai/gpt-oss-120b or openai/gpt-oss-20b.
# Groq's free tier allows 8,000 tokens per minute (200,000 per day). With the
# defaults below a request uses about 4,000-6,000, and repeats are served from the
# response cache for free. Keep LLM_EFFORT at medium: low saves about 1,200 tokens
# a request but measurably weakens the ranking and explanations.
LLM_MODEL=openai/gpt-oss-120b
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=60
# false: no LLM calls at all; every search gets the deterministic ranking (e.g. for a demo)
LLM_ENABLED=true
# Reuse a ranking for an identical request for this long (0 disables the cache)
LLM_CACHE_TTL_SECONDS=86400
# Prices in US dollars per million tokens, used to log each request's cost
# (Groq's rates for openai/gpt-oss-120b; update them if you change LLM_MODEL)
LLM_PRICE_INPUT=0.15
LLM_PRICE_CACHED_INPUT=0.075
LLM_PRICE_OUTPUT=0.60

# Candidate selection (CANDIDATE_TOP_K is raised to 2 x top_n when that is larger)
CANDIDATE_TOP_K=15
MIN_CANDIDATES=5

# Budget bands, in rupees for two people. Changing these requires re-running the ingest.
BUDGET_LOW_MAX=300
BUDGET_MEDIUM_MAX=600

# Source dataset (pinned revision for reproducible ingests)
# DATASET_REPO=ManikaSaini/zomato-restaurant-recommendation
# DATASET_REVISION=5738e9eda2fad49ad51c6e0ed26e761d9b947133

# Processed data file (defaults to data/processed/restaurants.parquet in the project root)
# DATA_PATH=data/processed/restaurants.parquet

# The API the demo script calls (scripts/demo.py)
API_BASE_URL=http://localhost:8000

# Browser origins allowed to call the API, as a JSON list: the web front end in web/.
# Locally that's Vite's dev server; on Render, the Vercel URL (docs/deployment-plan.md).
CORS_ORIGINS=["http://localhost:5173"]
# Optional: a pattern for this project's Vercel preview URLs, matched in full
# CORS_ORIGIN_REGEX=https://curated-cravings-[a-z0-9-]+-your-team\.vercel\.app

# Logging: JSON lines on stderr, one per request plus warnings and errors.
# Set LOG_FILE to also append them to a file, e.g. for the cost report:
#   python -m app.observability logs/api.jsonl
LOG_LEVEL=INFO
# LOG_FILE=logs/api.jsonl

# Quality evaluation only (tests/eval, docs/eval.md): the LLM judge. Use a model from a
# different family than LLM_MODEL. Prices are US dollars per million tokens.
# EVAL_JUDGE_MODEL=qwen/qwen3.8-27b
# EVAL_JUDGE_REASONING_EFFORT=none
# EVAL_JUDGE_PRICE_INPUT=0.80
# EVAL_JUDGE_PRICE_OUTPUT=4.00
